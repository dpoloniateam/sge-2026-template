# Copie para .env e preencha. O .env NUNCA vai para o git (está no .gitignore).
# --- Odoo (alvo do agente): base Odoo Online edu OU Odoo Community em Docker ---
ODOO_URL=http://localhost:8069            # ex.: https://edu-sge26-eq01.odoo.com
ODOO_DB=odoo                              # ex.: edu-sge26-eq01
ODOO_USER=admin                           # só usado pelo transporte JSON-RPC
ODOO_API_KEY=cole-aqui-a-chave-api        # Odoo: avatar > Preferências > Segurança da conta > Nova chave API
ODOO_API=auto                             # json2 | jsonrpc | auto (tenta JSON-2 e cai para JSON-RPC)
# --- LLM ---
LLM_PROVIDER=gemini                       # azure | gemini | ollama | openai
LLM_MODEL=                                # vazio = predefinição do fornecedor (azure: gpt-5-nano; gemini: gemini-3.6-flash; ollama: llama3.2)
EMBED_MODEL=                              # vazio = predefinição (azure: text-embedding-3-small; gemini: gemini-embedding-001; ollama: nomic-embed-text)
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
GEMINI_API_KEY=                           # https://aistudio.google.com (gratuito; só dados sintéticos)
OLLAMA_URL=http://localhost:11434/v1
OPENAI_BASE_URL=                          # qualquer endpoint compatível com a API OpenAI
OPENAI_API_KEY=
