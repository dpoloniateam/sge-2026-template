{
  "name": "SGE 2026-27 — Odoo + agente",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [8069],
  "portsAttributes": { "8069": { "label": "Odoo", "onAutoForward": "notify" } },
  "postCreateCommand": "pip install -r requirements.txt && docker compose up -d",
  "customizations": { "vscode": { "extensions": ["ms-python.python", "GitHub.copilot"] } }
}
